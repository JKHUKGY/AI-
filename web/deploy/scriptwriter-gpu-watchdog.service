[Unit]
Description=Scriptwriter GPU idle shutdown and email notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/AI-
ExecStart=/usr/bin/python3 web/server/gpu_watchdog.py
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
