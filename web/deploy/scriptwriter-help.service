[Unit]
Description=剧本家协作网站使用帮助
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/AI-
Environment="PATH=/home/deploy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 web/server/help_server.py --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
